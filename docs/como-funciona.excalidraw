  },
  {
   "id": "el0017",
   "type": "text",
   "x": 50,
   "y": 880,
   "width": 913.1,
   "height": 82.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 2035189461,
   "version": 1,
   "versionNonce": 132847737,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1763000000000,
   "link": null,
   "locked": false,
   "text": "• Fica com cara de brinquedo, e qualquer desenho novo é só uma lista de casas.\n• É barato: um quadro inteiro são poucas centenas de quadradinhos.\n• O fundo é preto de verdade. Em tela OLED, pixel preto fica desligado e não gasta bateria.",
   "originalText": "• Fica com cara de brinquedo, e qualquer desenho novo é só uma lista de casas.\n• É barato: um quadro inteiro são poucas centenas de quadradinhos.\n• O fundo é preto de verdade. Em tela OLED, pixel preto fica desligado e não gasta bateria.",
   "fontSize": 22,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
