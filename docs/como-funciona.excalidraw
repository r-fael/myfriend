   "updated": 1763000000000,
   "link": null,
   "locked": false,
   "text": "E os desenhos grandes?",
   "originalText": "E os desenhos grandes?",
   "fontSize": 26,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "el0094",
   "type": "text",
   "x": 50,
   "y": 1624,
   "width": 1748.2,
   "height": 55.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 597904679,
   "version": 1,
   "versionNonce": 1516975390,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1763000000000,
   "link": null,
   "locked": false,
   "text": "Chapéus, comidas e objetos não cabem em 5 × 5, então são desenhados com \"comandos\": pinte a linha do x 3 ao x 7, pinte esta casa de dourado... Tudo é medido a partir do\ncentro do rosto, e o que é simétrico (orelhas, chifres) é desenhado uma vez e espelhado para o outro lado. Isso fica em",
   "originalText": "Chapéus, comidas e objetos não cabem em 5 × 5, então são desenhados com \"comandos\": pinte a linha do x 3 ao x 7, pinte esta casa de dourado... Tudo é medido a partir do\ncentro do rosto, e o que é simétrico (orelhas, chifres) é desenhado uma vez e espelhado para o outro lado. Isso fica em",
   "fontSize": 22,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
