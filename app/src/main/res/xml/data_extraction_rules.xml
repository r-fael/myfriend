<?xml version="1.0" encoding="utf-8"?>
<!-- Backup do bichinho: nuvem e troca de relógio (Android 12+). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="myfriend_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="myfriend_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
